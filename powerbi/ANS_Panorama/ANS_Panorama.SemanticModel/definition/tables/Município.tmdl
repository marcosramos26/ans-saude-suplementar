		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaCurated & "\dims\dim_municipio.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"municipio_id", type text}, {"codigo_ibge", type text}, {"nome", type text}, {"uf_codigo", type text}, {"tipo", type text}, {"flag_codigo_inconsistente", Int64.Type}, {"classificacao_provisoria", Int64.Type}, {"codigo_origem", type text}, {"colide_com_nome_de_uf", Int64.Type}, {"origem", type text}}, "en-US")
				in
