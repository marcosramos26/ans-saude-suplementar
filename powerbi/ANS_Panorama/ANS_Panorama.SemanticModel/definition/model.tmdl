model ANS_Panorama
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Período","UF","Região","Município","Capital","Modalidade","Partição territorial","Catálogo de medidas","Recorte de vínculos","Operadora","Vínculos por UF e competência","Vínculos por recorte","Vínculos por partição","Vínculos por capital","Vínculos por município","Vínculos por operadora","Cobertura por UF e ano","Cobertura por município e ano","Receitas por operadora e ano","Receitas por modalidade e ano","PastaCurated"]

annotation __PBI_TimeIntelligenceEnabled = 1

