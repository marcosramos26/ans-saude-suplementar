            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\", \"data\": {\"name\": \"dataset\"}, \"width\": \"container\", \"height\": \"container\", \"padding\": {\"left\": 2, \"right\": 8, \"top\": 30, \"bottom\": 4}, \"transform\": [{\"calculate\": \"indexof([''Coletivo Empresarial'',''Individual ou Familiar'',''Coletivo por adesão''], datum.membro) >= 0 ? datum.membro : ''Outros''\", \"as\": \"grupo\"}, {\"calculate\": \"indexof([''Coletivo Empresarial'',''Individual ou Familiar'',''Coletivo por adesão'',''Outros''], datum.grupo)\", \"as\": \"gord\"}, {\"aggregate\": [{\"op\": \"sum\", \"field\": \"valor\", \"as\": \"valor\"}], \"groupby\": [\"sigla\", \"nome\", \"grupo\", \"gord\"]}, {\"joinaggregate\": [{\"op\": \"sum\", \"field\": \"valor\", \"as\": \"tot\"}], \"groupby\": [\"sigla\"]}, {\"calculate\": \"datum.valor / datum.tot\", \"as\": \"share\"}, {\"calculate\": \"datum.grupo == ''Individual ou Familiar'' ? datum.share : 0\", \"as\": \"indTmp\"}, {\"joinaggregate\": [{\"op\": \"max\", \"field\": \"indTmp\", \"as\": \"ind\"}], \"groupby\": [\"sigla\"]}, {\"stack\": \"share\", \"groupby\": [\"sigla\"], \"sort\": [{\"field\": \"gord\", \"order\": \"ascending\"}], \"as\": [\"x0\", \"x1\"]}, {\"calculate\": \"(datum.x0 + datum.x1) / 2\", \"as\": \"xm\"}, {\"calculate\": \"format(datum.share*100,''.0f'') + ''%''\", \"as\": \"lbl\"}, {\"calculate\": \"replace(format(datum.share*100,''.1f''),''.'','','') + ''%''\", \"as\": \"lblShare\"}, {\"calculate\": \"replace(format(datum.valor, '',.0f''), '','', ''.'')\", \"as\": \"lblFull\"}], \"encoding\": {\"y\": {\"field\": \"sigla\", \"type\": \"nominal\", \"sort\": {\"field\": \"ind\", \"op\": \"max\", \"order\": \"descending\"}, \"scale\": {\"paddingInner\": 0.22}, \"axis\": {\"title\": null, \"domain\": false, \"ticks\": false, \"labelFontSize\": 10, \"labelColor\": \"#5B6170\", \"labelPadding\": 6}}, \"tooltip\": [{\"field\": \"nome\", \"title\": \"UF\"}, {\"field\": \"grupo\", \"title\": \"Contratação\"}, {\"field\": \"lblFull\", \"title\": \"Vínculos\"}, {\"field\": \"lblShare\", \"title\": \"Participação na UF\"}]}, \"layer\": [{\"mark\": {\"type\": \"bar\"}, \"encoding\": {\"x\": {\"field\": \"x0\", \"type\": \"quantitative\", \"scale\": {\"domain\": [0, 1]}, \"axis\": {\"title\": null, \"domain\": false, \"ticks\": false, \"grid\": false, \"orient\": \"bottom\", \"values\": [0, 0.25, 0.5, 0.75, 1], \"labelExpr\": \"format(datum.value*100,''.0f'') + ''%''\"}}, \"x2\": {\"field\": \"x1\"}, \"color\": {\"field\": \"grupo\", \"type\": \"nominal\", \"scale\": {\"domain\": [\"Coletivo Empresarial\", \"Individual ou Familiar\", \"Coletivo por adesão\", \"Outros\"], \"range\": [\"#0E6E6B\", \"#8FB3A1\", \"#C49A5A\", \"#D9D6CE\"]}, \"legend\": {\"orient\": \"none\", \"legendX\": 0, \"legendY\": -30, \"direction\": \"horizontal\", \"title\": null, \"symbolType\": \"square\", \"symbolSize\": 80, \"labelFontSize\": 10, \"columnPadding\": 14}}}}, {\"transform\": [{\"filter\": \"datum.share >= 0.07 && datum.grupo != ''Outros''\"}], \"mark\": {\"type\": \"text\", \"fontSize\": 9, \"fontWeight\": 600}, \"encoding\": {\"x\": {\"field\": \"xm\", \"type\": \"quantitative\"}, \"text\": {\"field\": \"lbl\"}, \"color\": {\"condition\": {\"test\": \"datum.grupo == ''Coletivo Empresarial''\", \"value\": \"#FFFFFF\"}, \"value\": \"#16181D\"}}}]}'"
