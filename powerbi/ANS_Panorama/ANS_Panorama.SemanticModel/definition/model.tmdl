ref table 'Vínculos por município'
ref table 'Vínculos por operadora'
ref table 'Cobertura por UF e ano'
ref table 'Cobertura por município e ano'
ref table 'Receitas por operadora e ano'
ref table 'Receitas por modalidade e ano'
