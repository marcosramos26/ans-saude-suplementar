/// Grão: ano x modalidade. Receita anual de contraprestações em reais. A modalidade aqui é a massa de receitas, não a de vínculos.
table 'Receitas por modalidade e ano'
	lineageTag: e22c4e15-209c-433a-87c3-ff7039846ddb

	/// Receita anual de contraprestações em reais, por modalidade. Refere-se à massa de receitas, não à de vínculos.
	measure 'Receita de contraprestações (modalidade)' = SUM ( 'Receitas por modalidade e ano'[Receita de contraprestações] )
		formatString: R$ #,##0
		lineageTag: b548ad70-e20d-4007-86a3-2182bf985de7

	column periodo_id
		dataType: string
		isHidden
		lineageTag: e9cd94e7-2071-45ae-9821-9948ab5fd5c2
		sourceColumn: periodo_id

	column modalidade_id
		dataType: string
		isHidden
		lineageTag: 360bef66-0687-4d8f-8999-f5a5d4ad5389
		sourceColumn: modalidade_id

	/// Receita anual de contraprestações em reais, por modalidade.
	column 'Receita de contraprestações'
		dataType: double
		formatString: R$ #,##0
		lineageTag: 396f0664-7848-494d-85ac-037600597894
		summarizeBy: sum
		sourceColumn: receita_contraprestacoes_reais

	partition 'Receitas por modalidade e ano' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaCurated & "\fatos\fato_receitas_modalidade_ano.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"periodo_id", type text}, {"modalidade_id", type text}, {"receita_contraprestacoes_reais", type number}}, "en-US")
				in
				    Tipos

