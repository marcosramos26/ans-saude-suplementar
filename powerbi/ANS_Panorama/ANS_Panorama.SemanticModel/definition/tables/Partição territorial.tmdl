/// Partição paralela Capital x Interior. Soma o total nacional, mas não deve ser somada com as linhas de UF.
table 'Partição territorial'
	lineageTag: 2621667e-5196-4a5d-bb31-0c168c00db75

	column particao_id
		dataType: string
		isHidden
		lineageTag: 9b38df0b-0a2b-442c-ad93-711259f473ea
		sourceColumn: particao_id

	column Nome
		dataType: string
		lineageTag: 4d549a4f-d7d0-474f-84be-cd1f9878fb4a
		sourceColumn: nome
		sortByColumn: Ordem

	column Ordem
		dataType: int64
		isHidden
		lineageTag: 289c8b27-66bf-4c2e-b3f0-15eff8521046
		summarizeBy: none
		sourceColumn: ordem

	partition 'Partição territorial' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaCurated & "\dims\dim_particao.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"particao_id", type text}, {"nome", type text}, {"ordem", Int64.Type}}, "en-US")
				in
				    Tipos

