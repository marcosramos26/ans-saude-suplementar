/// Modalidades de operadora (9), união das modalidades dos vínculos e das receitas.
table Modalidade
	lineageTag: f9651cd0-7c6c-4e9f-9cff-090740fa6141

	column modalidade_id
		dataType: string
		isHidden
		lineageTag: 7f360c88-6f24-461a-accf-c6708898b367
		sourceColumn: modalidade_id

	column Nome
		dataType: string
		lineageTag: ba188570-eeb0-4700-a5c9-fdd02f6e2677
		sourceColumn: nome

	column Origem
		dataType: string
		isHidden
		lineageTag: f85e451d-218d-4c5a-b1c6-69024c03a860
		sourceColumn: origem

	partition Modalidade = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaCurated & "\dims\dim_modalidade.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"modalidade_id", type text}, {"nome", type text}, {"origem", type text}}, "en-US")
				in
				    Tipos

